{
  "name": "kineta",
  "version": "3.3.0",
  "private": true,
  "description": "Kineta — мобильная игра-тренажёр управления бионическим протезом по двум каналам ЭМГ или потоку СПППР",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs && node tests/e2e/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "serve": "npx --yes serve prototype",
    "apk": "npm --prefix mobile run apk"
  },
  "engines": { "node": ">=22" }
}
